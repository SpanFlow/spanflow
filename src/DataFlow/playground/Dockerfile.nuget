# The libraries playground built from the published NuGet packages instead of the source in libs/. Same app, same
# image layout as playground/Dockerfile; use this one to pin a library version or to check that what runs is exactly
# what nuget.org serves. Build from the repository root:
#
#   docker build -f playground/Dockerfile.nuget --build-arg LIBRARIES_VERSION=1.0.0 -t libraries-playground .
#   docker run -p 8080:8080 -v playground-data:/data -e Playground__AccessKey=choose-a-key libraries-playground
#
# Packages from somewhere else first (a version not yet on nuget.org, a private mirror): put the .nupkg files in
# playground/nuget-feed/ and they are tried before nuget.org.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG LIBRARIES_VERSION=1.0.0
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props NuGet.Config* ./
# Only the playground: libs/ is not in this image at all.
COPY playground/SpanFlow.Libraries.Playground/ playground/SpanFlow.Libraries.Playground/
# (This file is named too so the COPY has a source when nuget-feed/ does not exist.)
COPY playground/Dockerfile.nuget playground/nuget-feed* playground/nuget-feed/
RUN dotnet publish playground/SpanFlow.Libraries.Playground/SpanFlow.Libraries.Playground.csproj -c Release -o /app \
      -p:UseNuGetLibraries=true -p:LibrariesVersion=${LIBRARIES_VERSION} \
      -p:RestoreAdditionalProjectSources=/src/playground/nuget-feed \
 && test -f /app/SpanFlow.Expressions.dll

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .

RUN mkdir -p /data/files && chown -R app:app /data
VOLUME /data

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_EnableDiagnostics=0 \
    Playground__Mode=SelfHosted \
    Playground__DataFile=/data/playground.json \
    Playground__LocalFileRoots__0=/data/files
EXPOSE 8080

USER app
ENTRYPOINT ["dotnet", "SpanFlow.Libraries.Playground.dll"]
