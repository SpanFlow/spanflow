<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SpanFlow.Connectors.Http</PackageId>
    <Description>Builds HTTP requests the way an API tool does (query, headers, JSON, form, multipart, raw bodies) and signs them: API key, basic, bearer, OAuth 2 client credentials, token endpoints, login requests, Digest, Hawk, OAuth 1 and JWT bearer. Includes a per-host request throttle.</Description>
    <PackageTags>spanflow;http;rest;oauth;oauth1;digest;hawk;jwt;api-client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="..\SpanFlow.Expressions\SpanFlow.Expressions.csproj" />
  </ItemGroup>

</Project>
