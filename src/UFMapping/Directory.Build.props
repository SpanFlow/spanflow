<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit advisories (NU19xx) are about (often transitive) dependencies
         we may not directly control; keep them visible as warnings, but don't
         fail the build on them. Upgrade the flagged package to clear it. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>preview</LangVersion>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
  </PropertyGroup>

  <!-- NuGet packaging. Only SpanFlow.Mapping.Core and SpanFlow.Mapping.Engine opt in (src/Packable.props);
       the CLI, the designer API and the tests are never packed. Bump VersionPrefix per release, or pass
       -p:Version=x.y.z to dotnet pack. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>farazahmed614</Authors>
    <Company>SpanFlow</Company>
    <Product>SpanFlow Mapping</Product>
    <Copyright>Copyright 2026 farazahmed614</Copyright>
    <PackageProjectUrl>https://github.com/SpanFlow/spanflow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SpanFlow/spanflow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>spanflow;mapping;json;transform;data-mapping;etl</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- This repo is private; the public source is the exported SpanFlow/spanflow tree. Source Link would
         stamp the private remote and commit into the packages, so it stays off here; packing happens in the
         public repo, whose nuget workflow (.github/workflows/nuget.yml) passes -p:EnableSourceLink=true and
         -p:EnableSourceControlManagerQueries=true so the packages point at the public commit. -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
